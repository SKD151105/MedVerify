# ========================================================
# MedVerify Environment Configuration
# Copy this file to .env and insert your API keys if needed
# ========================================================

# LLM Providers (Default is "mock" for zero-cost offline development)
LLM_PROVIDER=mock                     # Options: "mock", "gemini", "openai"
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Vector Database (Default is "hybrid_local" using BM25 + Dense)
VECTOR_DB_TYPE=hybrid_local           # Options: "hybrid_local", "pinecone", "chroma"
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=medverify-pubmedqa

# Embeddings & Reranking Settings
DENSE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
USE_HEAVY_NLI=false                   # Set to "true" to download the 560MB DeBERTa NLI weights
